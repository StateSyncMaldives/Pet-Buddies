{
  "name": "pet-buddies-mv",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build && node scripts/generate-sw.mjs",
    "preview": "vite preview",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm build && wrangler deploy --config dist/server/wrangler.json",
    "test": "vitest --run"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "drizzle-orm": "^0.45.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.43.0",
    "@tanstack/router-plugin": "^1.168.19",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.10.6",
    "miniflare": "^4.20260701.0",
    "typescript": "^5.6.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.107.0"
  }
}
